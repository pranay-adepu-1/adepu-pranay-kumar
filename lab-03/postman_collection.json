    {
      "name": "02 - Query Parameters & Filters (Success)",
      "item": [
        {
          "name": "GET /books - Default Pagination & Sort",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books",
              "host": ["{{base_url}}"],
              "path": ["books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns array of books\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /books - Search by Title (LIKE)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books?search_q=Clean",
              "host": ["{{base_url}}"],
              "path": ["books"],
              "query": [
                { "key": "search_q", "value": "Clean" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Filtered results match 'Clean'\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.some(b => b.title.includes(\"Clean\"))).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /books - Order by Price DESC",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books?order_by=price&order=DESC",
              "host": ["{{base_url}}"],
              "path": ["books"],
              "query": [
                { "key": "order_by", "value": "price" },
                { "key": "order", "value": "DESC" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"First item price is higher or equal to second\", function () {",
                  "    var json = pm.response.json();",
                  "    if (json.data.length > 1) {",
                  "        pm.expect(json.data[0].price).to.be.at.least(json.data[1].price);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /books - Price Range Filter (BETWEEN)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books?min_price=20&max_price=45",
              "host": ["{{base_url}}"],
              "path": ["books"],
              "query": [
                { "key": "min_price", "value": "20" },
                { "key": "max_price", "value": "45" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"All books are within range [20, 45]\", function () {",
                  "    var json = pm.response.json();",
                  "    json.data.forEach(function(b) {",
                  "        pm.expect(b.price).to.be.at.least(20);",
                  "        pm.expect(b.price).to.be.at.most(45);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /books - Pagination (Limit 3 Offset 2)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books?limit=3&offset=2",
              "host": ["{{base_url}}"],
              "path": ["books"],
              "query": [
                { "key": "limit", "value": "3" },
                { "key": "offset", "value": "2" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns at most 3 items\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.length).to.be.at.most(3);",
                  "    pm.expect(json.limit).to.eql(3);",
                  "    pm.expect(json.offset).to.eql(2);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /books/:id - Get Single Book",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/{{book_id}}",
              "host": ["{{base_url}}"],
              "path": ["books", "{{book_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns book matching id\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.id).to.eql(Number(pm.variables.get(\"book_id\")));",
                  "});"
                ]
              }
            }
          ]
        }
      ]

      "item": [
        {
          "name": "GET Root Documentation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has student metadata\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.student.name).to.eql(\"Adepu Pranay Kumar\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Health Check",
